# name: test/sql/geography/arrow_scalar_udf.test
# description: Arrow scalar UDF conversion, scalar broadcasting, and buffer ownership
# group: [geography]

require geography

# Force multiple batches and retain variable-sized results after kernel destruction.
statement ok
CREATE TABLE arrow_inputs AS
SELECT i, CASE
  WHEN i % 5 = 0 THEN NULL
  WHEN i % 5 = 1 THEN 'POINT EMPTY'
  WHEN i % 5 = 2 THEN 'POINT (0 -80)'
  WHEN i % 5 = 3 THEN 'LINESTRING (0 0, 1 1)'
  ELSE 'POLYGON ((0 0, 1 0, 0 1, 0 0))'
END::GEOGRAPHY AS geog
FROM range(10000) t(i);

# Filtering produces selected vectors; mixed scalar/array arguments must broadcast.
statement ok
CREATE TABLE arrow_results AS
SELECT i, s2_area(geog) AS area, s2_length(geog) AS length,
       s2_perimeter(geog) AS perimeter,
       s2_distance(geog, 'POINT (90 0)'::GEOGRAPHY) AS distance,
       s2_max_distance('POINT (90 0)'::GEOGRAPHY, geog) AS max_distance,
       s2_union(geog, 'POINT (90 0)'::GEOGRAPHY) AS union_geog,
       s2_intersection(geog, 'POINT (90 0)'::GEOGRAPHY) AS intersection_geog,
       s2_difference(geog, 'POINT (90 0)'::GEOGRAPHY) AS difference_geog,
       s2_covering(geog) AS covering,
       s2_covering_fixed_level(geog, 5) AS fixed_covering,
       s2_bounds_box(geog) AS bounds
FROM arrow_inputs WHERE i % 2 = 0;

query IIIIIII
SELECT count(*), count(area), count(distance), count(union_geog),
       count(covering), count(bounds), count(fixed_covering)
FROM arrow_results;
----
5000	4000	3000	4000	4000	3000	4000

query IIIIII
SELECT count(*) FILTER (WHERE area > 0),
       count(*) FILTER (WHERE length > 0),
       count(*) FILTER (WHERE perimeter > 0),
       count(*) FILTER (WHERE max_distance >= distance),
       count(*) FILTER (WHERE s2_isempty(intersection_geog)),
       count(*) FILTER (WHERE s2_distance(union_geog, 'POINT (90 0)'::GEOGRAPHY) < 1e-6)
FROM arrow_results;
----
1000	1000	1000	3000	4000	4000

# LIST children use unsigned cell IDs, including IDs with the sign bit set.
query III
SELECT bool_and(cell::UBIGINT > 9223372036854775807),
       bool_and(s2_cell_contains(cell, 'POINT (0 -80)'::GEOGRAPHY::S2_CELL_CENTER::S2_CELL)),
       bool_and(s2_cell_level(cell) = 5)
FROM (SELECT unnest(fixed_covering) AS cell FROM arrow_results WHERE i % 5 = 2);
----
true	true	true

# Stored WKB results still work after all Arrow producer objects have been released.
query I
SELECT bool_and(s2_aswkb(r.difference_geog) = s2_aswkb(i.geog))
FROM arrow_results r JOIN arrow_inputs i USING (i)
WHERE r.i % 5 IN (2, 3, 4);
----
true

# Arrays on both sides, including a NULL on only one side.
query IIII
SELECT s2_distance(a::GEOGRAPHY, b::GEOGRAPHY) IS NULL,
       s2_max_distance(a::GEOGRAPHY, b::GEOGRAPHY) IS NULL,
       s2_union(a::GEOGRAPHY, b::GEOGRAPHY) IS NULL,
       s2_difference(a::GEOGRAPHY, b::GEOGRAPHY) IS NULL
FROM (VALUES (NULL, 'POINT (0 0)'), ('POINT (0 0)', NULL),
             ('POINT (0 0)', 'POINT (1 1)')) t(a, b);
----
true	true	true	true
true	true	true	true
false	false	false	false

# All scalar arguments: the kernel may return one row for a whole DuckDB batch.
query IIII
SELECT sum(s2_area('LINESTRING (0 0, 1 1)'::GEOGRAPHY)),
       count(s2_covering('POINT (0 -80)'::GEOGRAPHY)),
       count(s2_bounds_box('POINT (0 -80)'::GEOGRAPHY)),
       count(s2_union('POINT (0 0)'::GEOGRAPHY, 'POINT (1 1)'::GEOGRAPHY))
FROM range(5000);
----
0	5000	5000	5000

# Empty and NULL input follow the Arrow kernels' semantics.
query IIIIIII
SELECT s2_area('POINT EMPTY'::GEOGRAPHY),
       s2_distance('POINT EMPTY'::GEOGRAPHY, 'POINT (0 0)'::GEOGRAPHY),
       s2_max_distance('POINT (0 0)'::GEOGRAPHY, 'POINT EMPTY'::GEOGRAPHY),
       s2_bounds_box('POINT EMPTY'::GEOGRAPHY),
       s2_covering('POINT EMPTY'::GEOGRAPHY),
       'POINT EMPTY'::GEOGRAPHY::S2_CELL_CENTER,
       NULL::GEOGRAPHY::S2_CELL_CENTER;
----
0	NULL	NULL	NULL	[]	NULL	NULL

query III
SELECT s2_isempty(s2_intersection('POINT EMPTY'::GEOGRAPHY, 'POINT (1 1)'::GEOGRAPHY)),
       s2_isempty(s2_intersection('POINT (1 1)'::GEOGRAPHY, 'POINT EMPTY'::GEOGRAPHY)),
       s2_covering_fixed_level('POINT (0 0)'::GEOGRAPHY, NULL);
----
true	true	NULL

# Aggregate updates consume Arrow struct results and preserve group state.
query III rowsort
SELECT i % 5 AS grp, round(s2_box_struct(s2_bounds_box_agg(geog)).xmin, 8),
       round(s2_box_struct(s2_bounds_box_agg(geog)).xmax, 8)
FROM arrow_inputs WHERE i % 5 IN (2, 3) GROUP BY grp;
----
2	0.0	0.0
3	0.0	1.0

# A cast batch includes NULL, empty, and high-bit unsigned IDs.
statement ok
CREATE TABLE arrow_cells AS
SELECT geog::S2_CELL_CENTER::UBIGINT AS cell
FROM arrow_inputs WHERE i % 5 IN (0, 1, 2);

query III
SELECT count(cell),
       count(*) FILTER (WHERE cell > 9223372036854775807),
       count(*) FILTER (WHERE cell IS NULL)
FROM arrow_cells;
----
2000	2000	4000

# Kernel errors become SQL errors, and do not poison subsequent batches.
statement error
SELECT 'LINESTRING (0 0, 1 1)'::GEOGRAPHY::S2_CELL_CENTER;
----
Arrow scalar UDF

statement error
SELECT s2_covering_fixed_level('POINT (0 0)'::GEOGRAPHY, 31);
----
min_level must be between 0 and 30

query I
SELECT s2_area('POINT (0 0)'::GEOGRAPHY);
----
0

# Session export preferences and GeoArrow registrations do not change kernel layouts.
statement ok
SET arrow_large_buffer_size = true;

statement ok
SET arrow_output_list_view = true;

statement ok
SET arrow_lossless_conversion = true;

query I
SELECT count(*) FROM s2_register_geoarrow_extensions();
----
1

query III
SELECT count(s2_covering(geog)), count(s2_bounds_box(geog)),
       count(s2_union(geog, 'POINT (90 0)'::GEOGRAPHY))
FROM arrow_inputs;
----
8000	6000	8000

statement ok
RESET arrow_large_buffer_size;

statement ok
RESET arrow_output_list_view;

statement ok
RESET arrow_lossless_conversion;

statement ok
DROP TABLE arrow_results;

statement ok
DROP TABLE arrow_inputs;

statement ok
DROP TABLE arrow_cells;
